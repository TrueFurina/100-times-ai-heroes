# Ollama設定
# 標準モデル（デフォルト）: gpt-oss:20b
# 量子化版（低メモリ環境向け）: gpt-oss:20b-q4_K_M
# 高性能版（128GB以上の高スペックマシン向け）: gpt-oss:120b
LLM_PROVIDER=ollama
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_HOST=http://127.0.0.1:11434

# データディレクトリ（ローカルCSV保存先）
# 各実行の出力は $DATA_DIR/run_YYYYMMDD_HHMMSS/output.csv に保存されます
DATA_DIR=./data

# ローカル画像生成（既定では無効。CLIで --generate-images を指定すると有効）
GENERATE_IMAGES=false
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_MODEL_PROFILE=animagine-xl-4.0-opt
COMFYUI_MODEL_PROFILES_PATH=./config/comfyui/model_profiles.json
COMFYUI_WORKFLOW_PATH=./config/comfyui/text2image_api_workflow.json
# profileのcheckpointを使う場合は空欄のままにする
COMFYUI_CHECKPOINT_NAME=
COMFYUI_TIMEOUT_SECONDS=300
COMFYUI_POLL_INTERVAL_SECONDS=1
MEMORY_GUARD_ENABLED=true
MINIMUM_AVAILABLE_MEMORY_PERCENT=15
# 以下はprofileの値を上書きしたい場合だけ設定する
# COMFYUI_WIDTH=832
# COMFYUI_HEIGHT=1216
# COMFYUI_STEPS=28
# COMFYUI_CFG=5.0
# COMFYUI_SAMPLER=euler_ancestral
# COMFYUI_SCHEDULER=normal
# COMFYUI_NEGATIVE_PROMPT=...

# 任意のクラウドLLM（LLM_PROVIDER=openai または --provider openai の場合のみ使用）
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
