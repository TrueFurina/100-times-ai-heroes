{
  "project": "100-times-ai-heroes-local",
  "description": "ローカルCSV、Ollama、ComfyUIを使うキャラクター生成システム",
  "features": [
    {"id": "ENV001", "category": "environment", "name": "ローカル設定読み込み", "passes": true, "test": "test_config_defaults_and_env"},
    {"id": "OLL001", "category": "ollama", "name": "モデル存在確認", "passes": true, "test": "test_ollama_model_missing_does_not_pull"},
    {"id": "OLL002", "category": "ollama", "name": "推論実行", "passes": true, "test": "test_ollama_inference_reads_dict_response"},
    {"id": "CSV001", "category": "storage", "name": "seed CSV初期化と読み込み", "passes": true, "test": "test_local_storage_creates_and_validates_seed_files"},
    {"id": "CSV002", "category": "storage", "name": "seed CSV検証", "passes": true, "test": "test_seed_header_error"},
    {"id": "CSV003", "category": "storage", "name": "結果CSV出力", "passes": true, "test": "test_generation_writes_csv_and_expands_seeds"},
    {"id": "PRM001", "category": "prompts", "name": "キャラクタープロンプト", "passes": true, "test": "test_prompts_and_image_prompt"},
    {"id": "GEN001", "category": "generation", "name": "キャラクター生成ループ", "passes": true, "test": "test_generation_loop_writes_requested_number"},
    {"id": "GEN002", "category": "generation", "name": "ローカル画像生成", "passes": true, "test": "test_image_generation_writes_path_and_seed"},
    {"id": "IMG001", "category": "image-model", "name": "画像モデルprofile読み込み", "passes": true, "test": "test_image_model_profiles_cover_comparison_candidates"},
    {"id": "IMG002", "category": "image-model", "name": "モデル固有prompt生成", "passes": true, "test": "test_model_profile_prompt_uses_project_attributes"},
    {"id": "IMG003", "category": "image-model", "name": "Pony clip skip適用", "passes": true, "test": "test_comfyui_profile_can_apply_clip_skip"},
    {"id": "IMG004", "category": "image-model", "name": "ComfyUIモデル解放", "passes": true, "test": "test_comfyui_free_memory_calls_local_endpoint"},
    {"id": "MEM001", "category": "memory", "name": "画像生成前のメモリ安全弁", "passes": true, "test": "test_memory_guard_records_image_stage_and_stops"},
    {"id": "ERR001", "category": "error", "name": "生成失敗時の記録", "passes": true, "test": "test_generation_failure_keeps_previous_rows_and_records_error"},
    {"id": "LLM001", "category": "provider", "name": "任意OpenAIプロバイダー", "passes": true, "test": "test_openai_provider_uses_responses_api_without_real_network"}
  ]
}
